## Lines that were cut but are still called by level code. They play nothing.
const CUT := ["l2_dead_escort"]


## The current id for a line, following RENAMED.
static func resolve(id: String) -> String:
	return RENAMED.get(id, id)


static func has_line(id: String) -> bool:
	return LINES.has(resolve(id)) or id in CUT


static func get_line(id: String) -> Dictionary:
	return LINES.get(resolve(id), {})


static func scene(id: String) -> Dictionary:
	for s in SCENES:
		if s["id"] == id:
			return s
	return {}


## Line ids for one scene, in script order.
static func ids_in_scene(scene_id: String) -> Array[String]:
	var out: Array[String] = []
	for id in LINES:
		if LINES[id]["scene"] == scene_id:
			out.append(id)
	return out


## Lines recorded together in one take: a line with `with_previous` continues the
## last line before it in its scene by the same speaker (one-player `_solo`
## versions are always their own take). Each block is {id, speaker, scene, lines};
## `id` names the recording: `<first line>_block`, or the line's own id when it
## stands alone. VoiceSplit cuts a block's take back into one file per line.
static func blocks(scene_id: String) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var last := -1
	for id in ids_in_scene(scene_id):
		var l: Dictionary = LINES[id]
		if l.get("with_previous", false) and last != -1 and out[last]["speaker"] == l["speaker"]:
			out[last]["lines"].append(id)
			continue
		out.append({"speaker": l["speaker"], "scene": scene_id, "lines": [id]})
		if not id.ends_with("_solo"):
			last = out.size() - 1
	for b in out:
		b["id"] = b["lines"][0] + ("_block" if b["lines"].size() > 1 else "")
	return out


## A crew member's recordings folder under audio/voice/, like "crew_dana".
static func crew_dir(slug: String) -> String:
	return "crew_" + slug


## A bark's file name without the extension, the same in every crew folder.
static func bark_id(bark: String) -> String:
	return "crew_" + bark


## What this crew member says for a bark ("" if there's no such bark).
static func bark_text(slug: String, bark: String) -> String:
	return CREW.get(slug, {}).get("barks", {}).get(bark, "")
