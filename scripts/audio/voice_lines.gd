	"l1_trap_1": "l2_trap_1",
	"l1_trap_2": "l2_trap_2",
	"l1_hit_1": "l2_hit_1",
	"l1_hit_2": "l2_hit_2",
	"l1_hit_3": "l2_hit_3",
	"l1_hit_4": "l2_hit_4",
	"l1_hurt_1": "l2_hurt_1",
	"l1_hurt_2": "l2_hurt_2",
	"l1_hurt_3": "l2_hurt_3",
	"l1_downed": "l2_downed",
	"l1_killed": "l2_killed",
	"l1_tied_1": "l2_tied_1",
	"l1_tied_2": "l2_tied_2",
	"l1_contain_1": "l2_contain_1",
	"l1_contain_2": "l2_contain_2",
	"l1_login": "l2_login",
	"l1_selftest": "l2_selftest",
	"l1_found": "l2_found",
	"l1_no_badge": "l2_no_badge",
	"l1_panel_ok": "l2_panel_ok",
	"l1_panel_wrong": "l2_panel_wrong",
	"l1_exit_open": "l2_exit_open",
	"l1_lockdown_tied": "l2_lockdown_tied",
	"l1_sealed": "l2_sealed",
}
## Lines that were cut but are still called by level code. They play nothing.
const CUT := ["l2_dead_escort"]


## The current id for a line, following RENAMED.
static func resolve(id: String) -> String:
	return RENAMED.get(id, id)


static func has_line(id: String) -> bool:
	return LINES.has(resolve(id)) or id in CUT


static func get_line(id: String) -> Dictionary:
	return LINES.get(resolve(id), {})


static func scene(id: String) -> Dictionary:
	for s in SCENES:
		if s["id"] == id:
			return s
	return {}


## Line ids for one scene, in script order.
static func ids_in_scene(scene_id: String) -> Array[String]:
	var out: Array[String] = []
	for id in LINES:
		if LINES[id]["scene"] == scene_id:
			out.append(id)
	return out
