; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Null & Void"
config/description="Co-op survival-horror escape game where you code your way out."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Game="*res://scripts/core/game.gd"
Net="*res://scripts/net/net.gd"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/positional_shadow/atlas_16_bits=false
